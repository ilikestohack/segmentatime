// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  points        Int
  segmentOrder  String    @default("[]") // Array of numbers
  segmentTypes  String    @default("[]") // Array of strings
  segments      Segment[]
}

model Segment {
  id                        Int       @id @default(autoincrement())
  ts                        BigInt
  type                      Int
  title                     String
  timeAllocation            Int
  timeExtension             Int
  timeExtensionDifference   Int
  maxBreaks                 Int
  limits                    String    @default("[]") // Array of strings
  pointsAvailable           Int
  notes                     String
  completion                Int
  user                      User      @relation(fields: [userId], references: [id])
  userId                    Int
}